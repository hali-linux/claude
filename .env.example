# ─────────────────────────────────────────────────────────────
# 우리 가족 사진 - 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# 실제 비밀번호/키는 절대 Git에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://family:family@localhost:5432/family_photos?schema=public"

# 세션/초대 토큰 서명용 비밀키 (32자 이상 무작위 문자열)
# 생성: openssl rand -base64 48
AUTH_SECRET=

# 서비스 주소 (초대 링크 생성, CSRF Origin 검사, 쿠키 Secure 여부 결정에 사용)
# 운영환경에서는 반드시 https:// 주소를 사용하세요.
APP_URL="http://localhost:3000"

# true면 초대 없이도 누구나 가입 가능(가입 시 새 가족 생성). 기본 false: 최초 1명 + 초대받은 사람만 가입
ALLOW_OPEN_REGISTRATION=false

# 세션 유지 기간(일), 초대 링크 유효 시간(시간)
SESSION_MAX_AGE_DAYS=30
INVITATION_TTL_HOURS=72

# 업로드 제한 / ZIP 한 파일당 최대 사진 수 / 휴지통 보관 기간(일)
MAX_UPLOAD_MB=30
MAX_ZIP_PHOTOS=300
TRASH_RETENTION_DAYS=30

# 동시에 처리할 이미지 수(서버 CPU 코어 수에 맞게)
IMAGE_CONCURRENCY=2

# 날짜 표시/검색 기준 시간대
TZ=Asia/Seoul
NEXT_PUBLIC_TIMEZONE=Asia/Seoul

# 리버스 프록시(Nginx, ALB 등) 뒤에서 실행할 때 true → X-Forwarded-For를 클라이언트 IP로 사용
TRUST_PROXY=false

# ── 저장소 ──────────────────────────────────────────────────
# local: 서버 디스크(STORAGE_LOCAL_DIR)에 저장  /  s3: AWS S3 Private Bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ── AWS S3 (STORAGE_DRIVER=s3 일 때) ─────────────────────────
S3_BUCKET=
AWS_REGION=ap-northeast-2
# EC2/ECS에서 IAM Role을 쓰면 아래 두 값은 비워두세요(권장)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Presigned URL 유효 시간(초)
S3_PRESIGN_EXPIRES_SECONDS=900
# MinIO 등 S3 호환 스토리지를 쓸 때만
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── CloudFront (선택) ────────────────────────────────────────
# 설정하면 S3 Presigned URL 대신 CloudFront Signed URL을 발급합니다.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM 개인키. 줄바꿈은 \n 으로 적어도 됩니다.
CLOUDFRONT_PRIVATE_KEY=

# ── 메일 (선택) ──────────────────────────────────────────────
# 설정하면 초대 링크를 이메일로도 보냅니다. 예: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="우리 가족 사진 <no-reply@example.com>"
