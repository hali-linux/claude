# ModSecurity SPOE 에이전트 (≈ AWS WAF 평가 엔진)
[Unit]
Description=ModSecurity WAF agent for HAProxy (SPOE)
Documentation=file:///usr/local/share/doc/haproxy-waf/README.md
After=network.target
Before=haproxy.service

[Service]
Type=notify
User=modsec-spoa
Group=modsec-spoa
EnvironmentFile=-/etc/sysconfig/modsec-spoa
WorkingDirectory=/etc/modsec-spoa
ExecStart=/usr/local/bin/modsec-spoa $OPTIONS
# 규칙 검사 후 SIGHUP: 새 규칙이 잘못되면 reload가 실패하고 기존 규칙이 유지됩니다.
ExecReload=/usr/local/bin/modsec-spoa -t -rules /etc/modsec-spoa/main.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
LimitNOFILE=65536

# 보안 강화 (PCRE JIT 때문에 MemoryDenyWriteExecute는 쓰지 않음)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/log/modsec-spoa /var/lib/modsec-spoa

[Install]
WantedBy=multi-user.target
